{% extends 'base.html.twig' %}

{% block title %}Contact — Power 91{% endblock %}

{% block body %}
<section class="page-hero">
    <div class="shell">
        <p class="eyebrow">Studio line</p>
        <h1>Request a song, or talk to the station</h1>
        <p class="lede">If you have a concern, a dedication, or want to ask about advertising with Power 91, use the form. The right desk will pick it up.</p>
    </div>
</section>

<section class="section">
    <div class="shell contact-layout">
        <div class="form-wrap">
            {{ form_start(form, {attr: {class: 'contact-form', novalidate: 'novalidate'}}) }}
                {{ form_row(form.name) }}
                {{ form_row(form.email) }}
                {{ form_row(form.subject) }}
                {{ form_row(form.message) }}
                <button class="play-btn" type="submit">Send to the studio</button>
            {{ form_end(form) }}
        </div>
        <aside class="card contact-aside">
            <h2>Studio</h2>
            <p>{{ studioAddress }}</p>
            <p>Tel: {{ studioLine }}</p>
            <p>{{ studioHours }}</p>
            <p class="muted">{{ stationCity }} · {{ timezoneLabel }} on the live player.</p>
        </aside>
    </div>
</section>
{% endblock %}
